    "Tasse: il conto dell'anno scorso e un anticipo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes: last year's balance and an advance"
          }
        }
      }
    },
    "Tasse: secondo anticipo": {
      "extractionState": "manual",
      "localizations": {
